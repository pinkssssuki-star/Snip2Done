<Window x:Class="RemeberEr.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="False" Background="Black" ShowActivated="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Cursor="Cross"
        PreviewKeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp"
        MouseRightButtonUp="OnRightUp">

    <Window.Resources>
        <!-- 键帽：提示条里那几个键 -->
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeycapText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#F0F0F2"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D6D6DA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            确认按钮：黑底白勾。刻意低调 —— 它只是个「可以点了」的提示，
            不该用高饱和色去抢选区的注意力。
            容器 38 里放一块 28 的板子，四周留 5 给投影。
            勾的几何刻意以原点为中心（负坐标），这样 WPF 按包围盒居中就是真的居中。
        -->
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Border x:Name="plate" Width="28" Height="28" CornerRadius="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="#4DFFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                        <GradientStop Color="#3A3A40" Offset="0"/>
                                        <GradientStop Color="#1C1C20" Offset="0.45"/>
                                        <GradientStop Color="#0C0C0F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270"
                                                      Opacity="0.6" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <!--
                                勾必须包在 Viewbox 里。Path 在 Stretch=None（默认）下**不会**把几何体
                                的原点归零：它按原始坐标绘制，布局盒却按包围盒算，于是内容会整体
                                偏移「包围盒左上角」那么多。用 Viewbox 量一次再等比缩放到给定尺寸，
                                居中就由布局保证，不用手算坐标。
                            -->
                            <Viewbox Width="16" Height="16" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 1,6.5 L 5,10.5 L 13,1.5" Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="plate" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 整屏截图铺满。Stretch=Fill 是刻意的：窗口按显示器物理矩形摆，
             图也是同一块屏的物理像素，1:1 对上，不该有等比缩放。 -->
        <Image x:Name="Shot" Stretch="Fill"/>

        <Canvas x:Name="Layer">
            <!-- 四周压暗：EvenOdd 的几何组，选区那块挖成洞 -->
            <Path x:Name="Veil" Fill="#6B000000"/>

            <Rectangle x:Name="Sel" Stroke="#F2FFFFFF" StrokeThickness="1" Visibility="Collapsed"/>

            <Border x:Name="SizeTag" Visibility="Collapsed" CornerRadius="6"
                    Background="#E6101014" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8,3,8,3">
                <TextBlock x:Name="SizeText" Foreground="#F2F2F4" FontSize="11.5" FontWeight="Medium"/>
            </Border>

            <Button x:Name="ConfirmBtn" Style="{StaticResource ConfirmButton}" Visibility="Collapsed"
                    IsHitTestVisible="False" ToolTip="确认（Enter）"/>
        </Canvas>

        <!-- 提示条：底一条柔和的深色玻璃感 + 真键帽，别再是那种素到发窘的黑胶囊 -->
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                CornerRadius="14" Background="#D9141418" BorderBrush="#26FFFFFF" BorderThickness="1"
                Padding="14,9,14,9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="7" Background="#268B5CF6" BorderBrush="#4D8B5CF6" BorderThickness="1"
                        Padding="6,3,6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="✂" FontSize="11" Foreground="#C4B5FD"/>
                </Border>
                <TextBlock Style="{StaticResource HintText}" Text="拖动框选要记住的东西"/>
                <Rectangle Width="1" Height="14" Fill="#26FFFFFF" Margin="12,0,12,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Keycap}"><TextBlock Style="{StaticResource KeycapText}" Text="Enter"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="确认"/>
                <Border Style="{StaticResource Keycap}" Margin="10,0,2,0"><TextBlock Style="{StaticResource KeycapText}" Text="Esc"/></Border>
                <TextBlock Style="{StaticResource HintText}" Text="取消"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
