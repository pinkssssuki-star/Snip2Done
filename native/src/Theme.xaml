<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RemeberEr">

    <!--
        设计 token 全部照抄 panel.css。
        好消息：WPF 的长度单位和 CSS px 在 96 DPI 下是同一个东西，
        所以 CSS 里的 13px / 10px 圆角 / 6px 间距可以原样搬过来，不用换算。
    -->

    <local:BoolToVis x:Key="BoolToVis"/>
    <local:EmptyToVis x:Key="EmptyToVis"/>
    <local:Not x:Key="Not"/>
    <local:FirstChar x:Key="FirstChar"/>
    <local:RatioToPercent x:Key="RatioToPercent"/>
    <local:TagOn x:Key="TagOn"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Tx1" Color="#1c1c1e"/>
    <SolidColorBrush x:Key="Tx2" Color="#2c2c2e"/>
    <SolidColorBrush x:Key="Tx3" Color="#7a7a80"/>
    <SolidColorBrush x:Key="Tx4" Color="#86868c"/>
    <SolidColorBrush x:Key="Tx5" Color="#a1a1a6"/>
    <SolidColorBrush x:Key="TxFaint" Color="#c4c4c9"/>
    <SolidColorBrush x:Key="Accent" Color="#8b5cf6"/>
    <SolidColorBrush x:Key="AccentDeep" Color="#7c3aed"/>
    <SolidColorBrush x:Key="Green" Color="#10b981"/>
    <SolidColorBrush x:Key="Red" Color="#dc2626"/>
    <SolidColorBrush x:Key="Hair" Color="#12000000"/>

    <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- 空模板：给 Track 里那两个只用来翻页的 RepeatButton 用 -->
    <ControlTemplate x:Key="InvisibleRepeat" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>

    <!-- ============================================================ 细滚动条 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="tb" Background="#29000000" CornerRadius="3" Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tb" Property="Background" Value="#42000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource InvisibleRepeat}" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource InvisibleRepeat}" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ 顶栏图标按钮（.acts button） -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource Tx4}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#14000000"/>
                            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
                        </Trigger>
                        <!-- Tag=on：⚡ 演示加速 / ⚙ 设置页打开时的紫色高亮 -->
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="b" Property="Background" Value="#2e8b5cf6"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="danger"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="b" Property="Background" Value="#29ef4444"/>
                            <Setter Property="Foreground" Value="{StaticResource Red}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 幽灵按钮（.ghost） -->
    <!--
        分段标签页按钮。放在一个浅色圆角容器里，选中那个变白底 + 深色字。
        选中态用 Tag=on 表达（外面用 DataTrigger 绑到 VM 上的标签属性）。
    -->
    <Style x:Key="TabBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource Tx4}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,5,0,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
                        </Trigger>
                        <!-- 放在悬停之后：选中态要压过悬停 -->
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="b" Property="Background" Value="#ffffff"/>
                            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button">        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Tx4}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,3,8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Background="#b8ffffff"
                            BorderBrush="#1a000000" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#ffffff"/>
                            <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
                        </Trigger>
                        <!-- Tag=danger：不可逆的操作（倒垃圾）确认态，红底白字 -->
                        <Trigger Property="Tag" Value="danger">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Red}"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 快速记录的房间选择（.quick-rooms button） -->
    <Style x:Key="RoomBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Background="#ffffff"
                            BorderBrush="#1c000000" BorderThickness="1" Padding="0,6,0,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="b" Property="Background" Value="#268b5cf6"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#8c8b5cf6"/>
                            <Setter Property="Foreground" Value="#6d28d9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 输入框 -->
    <Style x:Key="QuickInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Tx1}"/>
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="8" Background="#ffffff"
                            BorderBrush="#21000000" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#a68b5cf6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 生命周期条（.life） -->
    <Style x:Key="LifeBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#17000000" CornerRadius="2" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" RadiusX="2" RadiusY="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#a855f7" Offset="0"/>
                                        <GradientStop Color="#ec4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 设置页滑块 -->
    <Style x:Key="PanelSlider" TargetType="Slider">
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="3" Background="#21000000" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Width="14" Height="14" Fill="{StaticResource Accent}"/>
                                                <Ellipse Width="14" Height="14" Stroke="#ffffff" StrokeThickness="2"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource InvisibleRepeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource InvisibleRepeat}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 开关（设置页的快速模式） -->
    <Style x:Key="SwitchToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="track" CornerRadius="12" Background="#26000000"/>
                        <Border x:Name="knob" Width="18" Height="18" CornerRadius="9" Background="#FFFFFF"
                                HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 段落小标题（.sec-h h2 / em） -->
    <Style x:Key="SecTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Tx4}"/>
        <Setter Property="TextBlock.LineHeight" Value="14"/>
    </Style>

    <Style x:Key="CountBadge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
    </Style>

    <!-- 空态（.empty） -->
    <Style x:Key="EmptyBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="#80ffffff"/>
        <Setter Property="BorderBrush" Value="#1f000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

</ResourceDictionary>
