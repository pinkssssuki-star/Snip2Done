<Window x:Class="RemeberEr.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="看它一眼"
        Width="560" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <!-- 顶栏那个「平时隐形、悬停浅灰、聚焦变白带紫边」的标题框 -->
        <Style x:Key="TitleBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Tx1}"/>
            <Setter Property="Padding" Value="7,5,7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="7" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0a000000"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#ffffff"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#8c8b5cf6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Tx1}"/>
            <Setter Property="Padding" Value="9,7,9,7"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="8" Background="#ffffff"
                                BorderBrush="#1c000000" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#8c8b5cf6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#faffffff" BorderBrush="#17000000" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="16" Direction="270" Opacity="0.30" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ 标题栏（可拖动） -->
            <Border Grid.Row="0" Padding="12,9,10,9" BorderBrush="#0f000000" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" x:Name="RoomTag" CornerRadius="6" Padding="8,2,8,2"
                            Background="#248b5cf6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TagText" Text="Wantdo" FontSize="10" FontWeight="Bold"
                                   Foreground="#6d28d9"/>
                    </Border>
                    <TextBox Grid.Column="1" x:Name="TitleField" Style="{StaticResource TitleBoxStyle}"
                             TextChanged="OnFieldChanged" LostFocus="OnFieldBlur"/>
                    <Button Grid.Column="2" x:Name="CloseBtn" Content="✕" Width="26" Height="26"
                            Style="{StaticResource IconBtn}" ToolTip="关闭" Click="OnClose"/>
                </Grid>
            </Border>

            <!-- ============================================ 图 -->
            <Border Grid.Row="1" Background="#f4f4f5" Padding="12" MinHeight="120">
                <Grid>
                    <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image x:Name="Pic" Stretch="Uniform"/>
                    </Border>

                    <!--
                        没有截图的时候，这块地方本来就是空的 —— 直接让它变成一个加号，
                        点了走一次框选，选完挂到这一条上。比在别处藏个「补图」按钮好找。
                    -->
                    <Button x:Name="AddShot" Click="OnAddShot" Cursor="Hand"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Width="104" Height="104" CornerRadius="12"
                                        Background="#ffffff" BorderBrush="#2a8b5cf6" BorderThickness="1.5">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontSize="34" FontWeight="Light"
                                                   Foreground="{StaticResource AccentDeep}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="补一张截图" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource Tx4}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#faf5ff"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 有图的时候，加号缩成右下角一个小圆钮，不挡内容 -->
                    <Button x:Name="AddShotSmall" Click="OnAddShot" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            ToolTip="换一张截图" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="sb" Width="30" Height="30" CornerRadius="15"
                                        Background="#e6ffffff" BorderBrush="#22000000" BorderThickness="1">
                                    <TextBlock Text="+" FontSize="17" FontWeight="Light"
                                               Foreground="{StaticResource AccentDeep}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="sb" Property="Background" Value="#ffffff"/>
                                        <Setter TargetName="sb" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================ 元信息 -->
            <StackPanel Grid.Row="2" Margin="14,9,14,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="来源" FontSize="11" FontWeight="SemiBold" Foreground="#3a3a3c"
                               Width="42" Margin="0,0,7,0"/>
                    <TextBlock x:Name="SrcText" FontSize="11" Foreground="#8a8a8e" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="记于" FontSize="11" FontWeight="SemiBold" Foreground="#3a3a3c"
                               Width="42" Margin="0,0,7,0"/>
                    <TextBlock x:Name="WhenText" FontSize="11" Foreground="#8a8a8e"/>
                </StackPanel>
                <StackPanel x:Name="LifeRow" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="生命值" FontSize="11" FontWeight="SemiBold" Foreground="#3a3a3c"
                               Width="42" Margin="0,0,7,0"/>
                    <TextBlock x:Name="LifeText" FontSize="11" Foreground="#8a8a8e"/>
                </StackPanel>
            </StackPanel>

            <!-- ============================================ 备注 -->
            <StackPanel Grid.Row="3" Margin="14,6,14,13">
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="备注" FontSize="10" Foreground="{StaticResource Tx5}"/>
                    <TextBlock x:Name="SavedText" Text="已保存" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Green}" HorizontalAlignment="Right" Opacity="0"/>
                </Grid>
                <TextBox x:Name="NoteField" Style="{StaticResource NoteBoxStyle}" Height="58"
                         TextChanged="OnFieldChanged" LostFocus="OnFieldBlur"/>
            </StackPanel>

            <!-- ============================================ 底部动作 -->
            <Grid Grid.Row="4" Margin="14,0,14,13">
                <TextBlock x:Name="DoneHint" FontSize="10" Foreground="#b0b0b6" VerticalAlignment="Center"/>
                <Button x:Name="GetDoneBtn" HorizontalAlignment="Right" Cursor="Hand" Click="OnGetDone">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="9" Padding="15,8,15,8" RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                                        <GradientStop Color="#10b981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✓ Get Done" FontSize="12" FontWeight="Bold" Foreground="#ffffff"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
