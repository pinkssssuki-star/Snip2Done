<Window x:Class="RemeberEr.ChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="放到哪"
        Width="312" Height="212"
        WindowStyle="None" AllowsTransparency="False" Background="#FFFFFFFF"
        ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <!-- 三个去向按钮：渐变底 + 主标题 + 副标题（和 chooser/index.html 的 button 一致） -->
        <Style x:Key="ChoiceBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="4,7,4,6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        不透明窗口 + DWM 圆角。原来这里是 AllowsTransparency=True 的分层窗口 + DropShadowEffect，
        但分层窗口在 150% 那块副屏上销毁时会「分段消失」；同类的不透明窗口（框选层）就没有这个问题。
        阴影改用 DWM 自带的（见 OnSourceInitialized 里 ExtendFrame 那段），圆角也交给 DWM。
    -->
    <Border CornerRadius="14" Background="#FFFFFFFF" BorderBrush="#14000000" BorderThickness="1" Padding="12"
            MouseRightButtonUp="OnRightUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 缩略图 + 「这一张是 Todo 还是 Wantdo？」 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="Thumb" Grid.Column="0" Width="64" Height="46" Margin="0,0,10,0"
                       Stretch="UniformToFill" VerticalAlignment="Top">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,64,46" RadiusX="7" RadiusY="7"/>
                    </Image.Clip>
                </Image>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadText" Text="这一张，是 Todo 还是 Wantdo？" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Tx2}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="SrcText" FontSize="11" LineHeight="14.8"
                               Foreground="#8a8a8e" TextWrapping="Wrap" MaxHeight="30" ClipToBounds="True"/>
                </StackPanel>
            </Grid>

            <TextBox x:Name="TitleBox" Grid.Row="1" Style="{StaticResource QuickInput}"
                     Padding="9,7,9,7" Margin="0,8,0,8"/>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ColGap3" Width="7"/>
                    <ColumnDefinition x:Name="ColWant" Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ChoiceBtn}" Click="OnPickToday">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                            <GradientStop Color="#f59e0b" Offset="0"/>
                            <GradientStop Color="#d97706" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel>
                        <TextBlock Text="Today" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="一天内" FontSize="9" Opacity="0.82" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ChoiceBtn}" Click="OnPickSoon">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                            <GradientStop Color="#3b82f6" Offset="0"/>
                            <GradientStop Color="#2563eb" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <!--
                        和两侧保持同一套排版：大字 + 一行小字。
                        天数输入框挪到底部提示行去了 —— 塞在按钮里会让中间这个
                        长得和两边不一样，一眼就看出来。
                    -->
                    <StackPanel>
                        <TextBlock Text="Soon" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <!-- 「两三天 or [空]」：那个空是**可以填数字的框**，不是三个字 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock Text="两三天 or" FontSize="9" Opacity="0.82"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Border Background="#3DFFFFFF" CornerRadius="4" Padding="3,0,3,0"
                                    MinWidth="26" VerticalAlignment="Center">
                                <TextBox x:Name="DaysBox" FontSize="9.5" FontWeight="SemiBold"
                                         Background="Transparent" BorderThickness="0" Foreground="#ffffff"
                                         CaretBrush="#ffffff" TextAlignment="Center"
                                         VerticalContentAlignment="Center" MinWidth="20"
                                         KeyDown="OnDaysKeyDown" PreviewTextInput="OnDaysInput"
                                         ToolTip="填天数；留空就随机 48~72 小时"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="WantBtn" Grid.Column="4" Style="{StaticResource ChoiceBtn}" Click="OnPickWant">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                            <GradientStop Color="#a855f7" Offset="0"/>
                            <GradientStop Color="#7c3aed" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel>
                        <TextBlock x:Name="WantLabel" Text="Wantdo" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WantSub" Text="无期限" FontSize="9" Opacity="0.82" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock FontSize="9.5" Foreground="#b0b0b6" VerticalAlignment="Center">
                    <Run Text="Esc 算了 · 1 2 3 直接选"/>
                </TextBlock>
                <TextBlock Text="留空则自动给个两三天内的期限" FontSize="9.5" Foreground="#b0b0b6"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
