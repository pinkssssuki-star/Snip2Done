<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemeberEr.OverlayWindow"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        Title="框选">

  <!--
    框选层：铺一张整屏截图，把选区之外压暗，拖出一个框。
    与原版 WPF 版行为逐条对齐：松手后选区不消失、可拖角微调、可拖内部平移、
    确认键是选区外侧的 ✓（快速模式下松手即定，不显示 ✓）。
  -->
  <Canvas x:Name="Root">

    <!-- 整屏截图（底图） -->
    <Image x:Name="Shot" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" />

    <!-- 压暗层：整屏矩形 + 选区矩形，EvenOdd 把选区挖成洞 -->
    <Path x:Name="Veil" Fill="#66000000" />

    <!-- 选区框 + 八个控制点 -->
    <Canvas x:Name="SelBox" IsHitTestVisible="False" IsVisible="False">
      <Rectangle x:Name="SelRect"
                 Stroke="#FF7C5CFF" StrokeThickness="1"
                 Fill="Transparent" />
      <Rectangle x:Name="H1" Width="6" Height="6" Fill="#FF7C5CFF" />
      <Rectangle x:Name="H2" Width="6" Height="6" Fill="#FF7C5CFF" />
      <Rectangle x:Name="H3" Width="6" Height="6" Fill="#FF7C5CFF" />
      <Rectangle x:Name="H4" Width="6" Height="6" Fill="#FF7C5CFF" />
    </Canvas>

    <!-- 尺寸标签 -->
    <Border x:Name="SizeTag" IsVisible="False"
            Background="#CC000000" CornerRadius="4" Padding="6,2">
      <TextBlock x:Name="SizeText" FontSize="11" Foreground="#FFF2EFF7" />
    </Border>

    <!-- ✓ 确认键：黑底白勾，贴在选区外侧，注意别压住选区内容 -->
    <Button x:Name="ConfirmBtn" IsVisible="False"
            Width="34" Height="34" Padding="0"
            Background="#E6000000" BorderThickness="0"
            CornerRadius="6" Cursor="Hand">
      <TextBlock Text="✓" FontSize="17" FontWeight="Bold" Foreground="#FFFFFFFF" />
    </Button>

    <!-- 还没框选时的提示条 -->
    <Border x:Name="Hint" Background="#B3000000" CornerRadius="8" Padding="14,8">
      <TextBlock FontSize="13" Foreground="#FFF2EFF7"
                 Text="拖动鼠标框选　·　Esc 取消" />
    </Border>

  </Canvas>
</Window>
