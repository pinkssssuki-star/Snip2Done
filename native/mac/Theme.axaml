<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RemeberEr">

  <!--
    设计 token 与控件样式。

    颜色/圆角/字号全部照抄自 WPF 版 native/src/Theme.xaml（那份又照抄自 Electron 版
    panel.css），这样两个平台的视觉是同源的，不会各长一套。

    与原版的一处必要差异：原版用 WPF 的 DataTrigger 在模板里切配色，
    Avalonia 的样式触发器语法不同（需要 `[!]` 选择器），
    因此改成「用转换器算出一个样式类，样式表按类上色」——
    效果等价，而且配色集中在 Styles.axaml 里，更好改。

    注意：样式**不能**写在本文件里（ResourceDictionary 只放资源），
    否则 Avalonia 会报 AVLN3000；控件样式在 Styles.axaml。
  -->

  <!-- ============================================================ 颜色 -->
  <SolidColorBrush x:Key="Tx1" Color="#1a1a1f"/>
  <SolidColorBrush x:Key="Tx2" Color="#4a4a55"/>
  <SolidColorBrush x:Key="Tx3" Color="#8a8a95"/>
  <SolidColorBrush x:Key="TxFaint" Color="#c4c4c9"/>
  <SolidColorBrush x:Key="Accent" Color="#8b5cf6"/>
  <SolidColorBrush x:Key="AccentDeep" Color="#7c3aed"/>
  <SolidColorBrush x:Key="Green" Color="#10b981"/>
  <SolidColorBrush x:Key="Red" Color="#dc2626"/>
  <SolidColorBrush x:Key="Hair" Color="#12000000"/>
  <SolidColorBrush x:Key="CardBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="TileBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="ShellBorder" Color="#14000000"/>

  <!-- pill 三色（对应 .pill-today / .pill-soon / .pill-bad） -->
  <SolidColorBrush x:Key="PillTodayBg" Color="#fef3c7"/>
  <SolidColorBrush x:Key="PillTodayFg" Color="#b45309"/>
  <SolidColorBrush x:Key="PillSoonBg" Color="#dbeafe"/>
  <SolidColorBrush x:Key="PillSoonFg" Color="#1d4ed8"/>
  <SolidColorBrush x:Key="PillBadBg" Color="#fee2e2"/>
  <SolidColorBrush x:Key="PillBadFg" Color="#b91c1c"/>
  <SolidColorBrush x:Key="PillPlainBg" Color="#0f000000"/>


  <!-- ==== 以下 token 是 v0.9.1 新增/新用到的，值取自上游 Theme.xaml ====
       这些 key 同时是 Palette 换主题时要改的目标：
       Theme.axaml 里定义出画刷实例，Palette.Apply 按同名 key 查出来原地改 Color，
       因为 StaticResource 解析出来的就是同一个实例，所有引用处会一起跟着变。 -->
  <SolidColorBrush x:Key="Tx4" Color="#86868c"/>
  <SolidColorBrush x:Key="Tx5" Color="#a1a1a6"/>
  <SolidColorBrush x:Key="Cx1" Color="#1c1c1e"/>          <!-- 卡片正文，不随主题变 -->
  <SolidColorBrush x:Key="Cx2" Color="#2c2c2e"/>          <!-- 卡片次级，不随主题变 -->
  <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ChipBg" Color="#12000000"/>
  <SolidColorBrush x:Key="HintTx" Color="#9a9aa0"/>
  <SolidColorBrush x:Key="BtnBg" Color="#b8ffffff"/>
  <SolidColorBrush x:Key="BtnBgHover" Color="#ffffff"/>
  <SolidColorBrush x:Key="BtnBorder" Color="#1a000000"/>
  <SolidColorBrush x:Key="TabOnBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="InputBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="TrackBg" Color="#21000000"/>
  <SolidColorBrush x:Key="ThumbBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="EmptyBg" Color="#80ffffff"/>
  <SolidColorBrush x:Key="EmptyBorder" Color="#1f000000"/>
  <SolidColorBrush x:Key="HoverBg" Color="#14000000"/>
  <SolidColorBrush x:Key="SwatchRing" Color="#33000000"/>
  <SolidColorBrush x:Key="RoomBorder" Color="#33000000"/>

  <!-- ============================================================ 转换器 -->
  <local:BoolToVis x:Key="BoolToVis"/>
  <local:EmptyToVis x:Key="EmptyToVis"/>
  <local:Not x:Key="Not"/>
  <local:FirstChar x:Key="FirstChar"/>
  <local:RatioToPercent x:Key="RatioToPercent"/>
  <local:TagOn x:Key="TagOn"/>
  <local:AsIs x:Key="AsIs"/>
  <local:LifeClass x:Key="LifeClass"/>

  <!-- ============================================================ 字体与基础 -->
  <FontFamily x:Key="UiFont">Inter, -apple-system, Helvetica Neue, PingFang SC, Microsoft YaHei</FontFamily>

  <!-- ============================================================ 顶栏图标按钮 -->

  <!-- 开关处于打开状态（Tag=on）：用强调色标出来 -->

  <!-- ============================================================ 分区标题 -->

