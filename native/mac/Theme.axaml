  <!-- ============================================================ Todo 卡片 -->

  <!-- 已完成的卡片整体降调，和 HTML 版的 .done 一致 -->

  <!-- 勾选框 -->

  <!-- pill 徽章 -->

  <!-- 卡片里的小缩略图 -->

