<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemeberEr"
        x:Class="RemeberEr.PanelWindow"
        Width="340" Height="520"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        Title="记忆面板">

  <Window.Resources>
    <!--
      两个条目模板。
      注意模板里要访问面板级命令（勾选完成、打开详情），用
      $parent[Window].DataContext 往回找 —— 条目 VM 自己不该持有面板命令，
      否则每一条都要复制一堆引用。
    -->

        <!-- ================================================ Todo 卡片 -->
    <DataTemplate x:Key="TodoCardTpl">
      <Border Classes="TodoCard"
              Classes.done="{Binding IsDone}"
              PointerReleased="OnTodoCardClick"
              PointerEntered="OnCardHoverIn"
              PointerExited="OnCardHoverOut">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

          <!-- 勾选框：先只标记完成，留在原地让你能反悔 -->
          <Button Grid.Column="0" Classes="Check"
                  Classes.checked="{Binding IsDone}"
                  Command="{Binding $parent[Window].DataContext.ToggleDoneCmd}"
                  CommandParameter="{Binding Id}">
            <TextBlock Text="✓"/>
          </Button>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <!--
              卡片里的字一律用 Cx1 / Cx2，**不用** Tx1 / Tx2。
              条目卡片永远白底（设计原则第 5 条），底色不跟主题走；
              字色要是跟着主题走，黑主题下就会变成浅字压白底、几乎看不见 —— 实测踩到过。
            -->
            <TextBlock Text="{Binding Title}"
                       FontSize="12.5" LineHeight="16.5" FontWeight="Medium"
                       Foreground="{StaticResource Cx1}"
                       TextWrapping="Wrap" MaxHeight="33" ClipToBounds="True"
                       IsVisible="{Binding HasTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <Border Classes="Pill"
                      Classes.today="{Binding PillKind, Converter={StaticResource AsIs}}"
                      IsVisible="{Binding HasPill}">
                <TextBlock Text="{Binding PillText}"/>
              </Border>
              <!-- 没标题时补来源，避免卡片看起来是空的 -->
              <TextBlock Text="{Binding MetaSource}" FontSize="10"
                         Foreground="{StaticResource Tx3}" VerticalAlignment="Center"
                         IsVisible="{Binding ShowMetaSource}"/>
              <TextBlock Text="{Binding MetaTime}" FontSize="10"
                         Foreground="{StaticResource TxFaint}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="3" Classes="CardThumb" IsVisible="{Binding HasThumb}">
            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ================================================ Wantdo 磁贴 -->
    <DataTemplate x:Key="WantTileTpl">
      <Border Classes="Tile" PointerReleased="OnWantTileClick"
              PointerEntered="OnCardHoverIn" PointerExited="OnCardHoverOut">
        <!--
          布局分三层，生命条用「贴底叠加」而不是参与流式排版：
            · 图片区固定 60px
            · 文字区（副标题 + 可选提示）占剩余空间
            · 生命条：2px 细线，绝对贴在磁贴最底部（VerticalAlignment=Bottom）

          为什么生命条要贴底：它一旦参与流式排版，长副标题 + 「还能撑 N 天」
          两行文字就会把它挤出磁贴外 —— 从自检截图上看过这个现象。
          贴底之后，无论文字多长，生命条永远在最下面那一条。
        -->
        <Grid>
          <Grid RowDefinitions="54,*,Auto">
            <!--
              图片走 Border 的**底色**（ImageBrush）而不是当子元素 ——
              Border 的 CornerRadius 会裁剪它自己的底色，但**不会裁剪子元素**，
              ClipToBounds 也只按矩形裁。用 Image 的话上面那张图会盖过圆角，
              看起来上边缘是直角（上游踩过，我这边原来也是同一个写法）。
            -->
            <Grid Grid.Row="0">
              <Border CornerRadius="10,10,0,0" IsVisible="{Binding HasThumb}">
                <Border.Background>
                  <ImageBrush Source="{Binding Thumb}" Stretch="UniformToFill"/>
                </Border.Background>
              </Border>
              <Border CornerRadius="10,10,0,0" Background="{StaticResource AccentDeep}"
                      IsVisible="{Binding !HasThumb}">
                <TextBlock Text="{Binding FirstChar}"
                           FontSize="30" FontWeight="SemiBold" Foreground="#ffffff"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="7,3,7,1" Spacing="2" ClipToBounds="True">
              <TextBlock Text="{Binding Caption}" FontSize="10.5"
                         Foreground="{StaticResource Cx2}"
                         TextWrapping="Wrap" MaxHeight="26" LineHeight="13"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding FadingHint}" FontSize="9.5"
                       Foreground="{StaticResource Red}" Margin="7,0,7,5"
                       IsVisible="{Binding ShowFadingHint}"/>
          </Grid>

          <!--
            生命条：贴在最底部的一根细线。
            高度/内边距全部显式写死（不只靠样式），因为 ProgressBar 的默认模板
            带 MinHeight 与内边距，会把它顶成一条粗灰条并把提示文字挤出磁贴 ——
            写法上宁可啰嗦，也不要依赖样式的优先级。
          -->
          <ProgressBar Classes="LifeBar"
                       Classes.low="{Binding LifePercent, Converter={StaticResource LifeClass}}"
                       Minimum="0" Maximum="100"
                       Value="{Binding LifePercent}"
                       Height="4" MinHeight="4" MinWidth="0"
                       Padding="0" BorderThickness="0" CornerRadius="2"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <!--
      外壳底色**刻意不绑** PanelBackground，由 code-behind 的 ApplyPanelBackground 独占设置。
      原因：绑定和本地值会互相覆盖 —— Refresh() 里为了别的字段会 Raise("PanelBackground")，
      绑定随即把旧值写回来，把刚设好的新主题底色冲掉（实测：黑色主题下面板仍是浅色，
      而 Palette.Current 明明是黑的）。少了这个绑定，"谁负责底色" 就只有一处。
    -->
    <Border x:Name="Shell" CornerRadius="14" BorderThickness="1"
            Background="#CCFFFFFF"
            BorderBrush="{StaticResource ShellBorder}"
            ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- ============================================ 顶栏（可拖动） -->
      <Border Grid.Row="0" Padding="12,9,10,9"
              BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
              Background="Transparent" PointerPressed="OnHeaderDrag">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="记忆面板" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <!-- 环境诊断开关：移植期用来查看平台层实情，后面收进设置页 -->
            <Button Classes="IconBtn" Content="?" ToolTip.Tip="环境诊断"
                    Click="OnDiagToggle"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1">
            <Button Classes="IconBtn" Content="✂" ToolTip.Tip="截图（⌘⇧A）"
                    Command="{Binding SnipCmd}"/>
            <Button Classes="IconBtn" Content="＋" ToolTip.Tip="手动记一笔"
                    Command="{Binding ToggleQuickCmd}"/>
            <Button Classes="IconBtn" Content="⚡" ToolTip.Tip="演示加速：约 5 分钟跑完一次完整淡出"
                    Tag="{Binding DemoOn, Converter={StaticResource TagOn}}"
                    Command="{Binding DemoToggleCmd}"/>
            <Button Classes="IconBtn" Content="⚙" ToolTip.Tip="设置"
                    Tag="{Binding SettingsOn, Converter={StaticResource TagOn}}"
                    Command="{Binding SettingsCmd}"/>
            <Button Classes="IconBtn" Content="⇧" ToolTip.Tip="窗口置顶（关掉就不会一直压在最上面）"
                    Tag="{Binding AlwaysOnTop, Converter={StaticResource TagOn}}"
                    Command="{Binding ToggleTopmostCmd}"/>
            <!--
              「隐藏折叠按钮」（v0.9.1 第 5 项）。一个必须加的保护：
              **已经折叠着的时候按钮必须留着** —— 否则用户把 ▾ 藏了又正好折着，
              就永远展不开了。规则是「显示 = 没隐藏 || 正折叠着」，
              这条规则在 ViewModels 的 ShowCollapseButton 里。
            -->
            <Button Classes="IconBtn" Content="{Binding CollapseGlyph}" ToolTip.Tip="折叠"
                    IsVisible="{Binding ShowCollapseButton}"
                    Command="{Binding CollapseCmd}"/>
            <Button Classes="IconBtn" Content="✕" Tag="danger" ToolTip.Tip="退出（⌘⇧Q）"
                    Command="{Binding QuitCmd}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================================ 手动记一笔 -->
      <!-- 底部内边距 9 -> 12：按钮下沿离分隔线太近时，那 1px 描边会被视觉上"吃掉" -->
      <Border Grid.Row="1" Padding="10,9,10,12"
              BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
              IsVisible="{Binding QuickOpen}">
        <StackPanel Spacing="7">
          <!-- 输入框后面跟一个加号：写完字得有个看得见的「加」可以点。
               上游收到的反馈就是「写完字以后不知道怎么加」。 -->
          <Grid ColumnDefinitions="*,6,Auto">
            <TextBox x:Name="QuickBox" Grid.Column="0" Classes="QuickInput"
                     Text="{Binding QuickText}" PlaceholderText="记一笔…"
                     KeyDown="OnQuickKeyDown"/>
            <Button Grid.Column="2" Click="OnQuickAdd" Cursor="Hand" ToolTip.Tip="加进去（Enter）">
              <Button.Template>
                <ControlTemplate>
                  <Border x:Name="qb" Width="30" Height="30" CornerRadius="8"
                          Background="{StaticResource Accent}" BorderThickness="0">
                    <TextBlock Text="+" FontSize="18" FontWeight="SemiBold"
                               Foreground="#ffffff"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,6,*">
            <Button Grid.Column="0" Classes="RoomBtn" Content="Todo"
                    Classes.on="{Binding QuickTodoOn}"
                    Command="{Binding SetRoomCmd}" CommandParameter="todo"/>
            <Button Grid.Column="2" Classes="RoomBtn" Content="Wantdo"
                    Classes.on="{Binding QuickWantOn}"
                    Command="{Binding SetRoomCmd}" CommandParameter="want"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============================================ 诊断面板（默认隐藏） -->
      <Border Grid.Row="2" Padding="10" IsVisible="{Binding $parent[Window].DiagOn}">
        <ScrollViewer>
          <TextBlock x:Name="DiagText" FontSize="11" Foreground="{StaticResource Tx2}"
                     TextWrapping="Wrap" LineHeight="17"/>
        </ScrollViewer>
      </Border>

      <!-- ============================================ 主体 -->
      <Grid Grid.Row="2" Margin="10" IsVisible="{Binding !$parent[Window].DiagOn}">

        <!-- ········ 主视图 ········ -->
        <Grid x:Name="MainView" IsVisible="{Binding IsMainView}" RowDefinitions="260*,10,120*,Auto">

          <!-- Todo -->
          <Grid x:Name="TodoSection" Grid.Row="0" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="1,0,1,6" ColumnDefinitions="Auto,Auto,*">
              <TextBlock Grid.Column="0" Classes="SecTitle" Text="TODO" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Classes="CountBadge" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding NTodo}"/>
              </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Todos}" ItemTemplate="{StaticResource TodoCardTpl}"/>
                <Border Classes="EmptyBox" IsVisible="{Binding !HasTodos}">
                  <TextBlock Text="还没有 Todo。按 ⌘⇧A 截一张，或点 ＋ 手动记一笔。"/>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Wantdo -->
          <Grid x:Name="WantSection" Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="1,0,1,6" ColumnDefinitions="Auto,Auto,*">
              <TextBlock Grid.Column="0" Classes="SecTitle" Text="WANTDO" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Classes="CountBadge" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding NWant}"/>
              </Border>
            </Grid>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <StackPanel>
                <!--
                  Wantdo 是**横向一排**磁贴（原版如此，可横向滚动）。
                  ItemsControl 默认的 ItemsPanel 是纵向 StackPanel，
                  必须显式换成横向 —— 否则磁贴会竖着叠成一列。
                  这个坑是从自检渲染出来的截图上直接看出来的。
                -->
                <ItemsControl ItemsSource="{Binding Wants}" ItemTemplate="{StaticResource WantTileTpl}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Classes="EmptyBox" IsVisible="{Binding !HasWants}">
                  <TextBlock Text="还没有 Wantdo。想做的事记在这里，你不碰它，它就会慢慢变淡。"/>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ==== 演示加速横幅：只在演示中 / 刚演完时出现 ====
               橙色 = 正在发生，紫色 = 说完了。 -->
          <Border Grid.Row="3" CornerRadius="9" Padding="10,9" Margin="0,8,0,0"
                  BorderThickness="1"
                  IsVisible="{Binding ShowDemoBanner}"
                  Classes="DemoBanner"
                  Classes.finished="{Binding DemoFinished}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DemoBannerText}" FontSize="10.5"
                         LineHeight="16" TextWrapping="Wrap" VerticalAlignment="Center"
                         Foreground="{StaticResource Tx2}" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Classes="GhostBtn" Content="停下" Padding="9,3"
                      VerticalAlignment="Center" IsVisible="{Binding DemoOn}"
                      Command="{Binding StopDemoCmd}"/>
              <Button Grid.Column="1" Classes="GhostBtn" Content="知道了" Padding="9,3"
                      VerticalAlignment="Center" IsVisible="{Binding DemoFinished}"
                      Command="{Binding DismissDemoCmd}"/>
            </Grid>
          </Border>
        </Grid>

        <!-- ········ 纸篓视图 ········ -->
        <!--
          v0.9.1：纸篓按房间分成两个标签页。这不是「两个动作」，是**两种相反的态度**：
            使命 Todo  —— 你主动 ✕ 舍弃的、有 DDL 的事 · 不能捡回 · 顶部「倒垃圾」一次清空
            初心 Wantdo —— 长期不碰、自己淡进来的念想 · 点一下捡回 · 永远不删
          「倒垃圾」是整个程序里唯一不可逆的操作，所以点第一下只把按钮变成红底的
          「确定清空？」，4 秒不点自己缩回去，点第二下才真删。
        -->
        <Grid IsVisible="{Binding IsBinView}" RowDefinitions="Auto,Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="1,0,1,8">
            <Button Grid.Column="0" Classes="GhostBtn" Content="← 返回"
                    Command="{Binding BackCmd}"/>
            <TextBlock Grid.Column="1" Classes="SecTitle" Text="PAPER PLANE BIN"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>

          <!-- 纸篓的一句话 -->
          <Border Grid.Row="1" CornerRadius="9" Background="{StaticResource BtnBg}"
                  BorderBrush="{StaticResource EmptyBorder}" BorderThickness="1"
                  Padding="10,11" Margin="0,0,0,10">
            <TextBlock FontSize="11.5" LineHeight="19" Foreground="{StaticResource Tx3}"
                       TextWrapping="Wrap" TextAlignment="Center">
              <Run Text="童年的纸飞机，"/><LineBreak/><Run Text="是否还能飞回你手里~"/>
            </TextBlock>
          </Border>

          <!-- 两个标签页 -->
          <Border Grid.Row="2" Background="{StaticResource ChipBg}" CornerRadius="9"
                  Padding="3" Margin="0,0,0,10">
            <UniformGrid Columns="2">
              <Button Classes="TabBtn" Classes.on="{Binding IsBinTodo}"
                      Content="使命 Todo"
                      Command="{Binding BinTabCmd}" CommandParameter="todo"/>
              <Button Classes="TabBtn" Classes.on="{Binding IsBinWant}"
                      Content="初心 Wantdo"
                      Command="{Binding BinTabCmd}" CommandParameter="want"/>
            </UniformGrid>
          </Border>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
              <!-- 使命 Todo：不能捡回，只能倒垃圾 -->
              <StackPanel IsVisible="{Binding IsBinTodo}">
                <Grid Margin="1,0,1,6">
                  <TextBlock Text="主动舍弃的，倒掉就不再回来" FontSize="10"
                             Foreground="{StaticResource Tx5}" VerticalAlignment="Center"/>
                  <Button HorizontalAlignment="Right" Content="{Binding EmptyTrashText}"
                          Classes="GhostBtn"
                          Classes.danger="{Binding ConfirmingEmpty}"
                          Command="{Binding EmptyTrashCmd}"
                          IsVisible="{Binding HasTodoBins}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding TodoBins}"
                              IsVisible="{Binding HasTodoBins}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="BinCard"
                              PointerReleased="OnBinCardClick"
                              PointerEntered="OnCardHoverIn" PointerExited="OnCardHoverOut">
                        <Grid RowDefinitions="*,Auto">
                          <Grid Grid.Row="0">
                            <!-- 同上：图片走底色，圆角才会生效 -->
                            <Border CornerRadius="10,10,0,0" IsVisible="{Binding HasThumb}">
                              <Border.Background>
                                <ImageBrush Source="{Binding Thumb}" Stretch="UniformToFill"/>
                              </Border.Background>
                            </Border>
                            <Border CornerRadius="10,10,0,0" IsVisible="{Binding !HasThumb}">
                              <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#cbd5e1" Offset="0"/>
                                  <GradientStop Color="#94a3b8" Offset="1"/>
                                </LinearGradientBrush>
                              </Border.Background>
                              <TextBlock Text="{Binding FirstChar}" FontSize="20" FontWeight="SemiBold"
                                         Foreground="#ffffff"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                          <StackPanel Grid.Row="1" Margin="7,4,7,5">
                            <StackPanel Orientation="Horizontal">
                              <Border Padding="5,1" CornerRadius="4" Margin="0,0,5,0"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource ChipBg}">
                                <TextBlock Text="{Binding RoomName}" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{StaticResource Tx3}"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Caption}" FontSize="10" Margin="0,3,0,0"
                                       Foreground="{StaticResource Cx2}"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="EmptyBox" Height="86" IsVisible="{Binding !HasTodoBins}">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="没有舍弃的 Todo。" FontSize="11"
                               Foreground="{StaticResource Tx4}" HorizontalAlignment="Center"/>
                    <TextBlock Text="丢掉的会落到这里，攒着一起倒。" FontSize="10" Margin="0,4,0,0"
                               Foreground="{StaticResource Tx5}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 初心 Wantdo：能捡回，永不删 -->
              <StackPanel IsVisible="{Binding IsBinWant}">
                <TextBlock Text="慢慢淡掉的，点一下就能捡回来" FontSize="10"
                           Foreground="{StaticResource Tx5}" Margin="1,0,1,6"/>
                <ItemsControl ItemsSource="{Binding WantBins}"
                              IsVisible="{Binding HasWantBins}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="BinCard"
                              PointerReleased="OnBinCardClick"
                              PointerEntered="OnCardHoverIn" PointerExited="OnCardHoverOut">
                        <Grid RowDefinitions="*,Auto">
                          <Grid Grid.Row="0">
                            <!-- 同上：图片走底色，圆角才会生效 -->
                            <Border CornerRadius="10,10,0,0" IsVisible="{Binding HasThumb}">
                              <Border.Background>
                                <ImageBrush Source="{Binding Thumb}" Stretch="UniformToFill"/>
                              </Border.Background>
                            </Border>
                            <Border CornerRadius="10,10,0,0" IsVisible="{Binding !HasThumb}">
                              <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#cbd5e1" Offset="0"/>
                                  <GradientStop Color="#94a3b8" Offset="1"/>
                                </LinearGradientBrush>
                              </Border.Background>
                              <TextBlock Text="{Binding FirstChar}" FontSize="20" FontWeight="SemiBold"
                                         Foreground="#ffffff"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                          <StackPanel Grid.Row="1" Margin="7,4,7,5">
                            <StackPanel Orientation="Horizontal">
                              <Border Padding="5,1" CornerRadius="4" Margin="0,0,5,0"
                                      VerticalAlignment="Center"
                                      Background="#24a855f7">
                                <TextBlock Text="{Binding RoomName}" FontSize="8.5" FontWeight="Bold"
                                           Foreground="#6d28d9"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Caption}" FontSize="10" Margin="0,3,0,0"
                                       Foreground="{StaticResource Cx2}"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="EmptyBox" Height="86" IsVisible="{Binding !HasWantBins}">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="还没有淡掉的念想。" FontSize="11"
                               Foreground="{StaticResource Tx4}" HorizontalAlignment="Center"/>
                    <TextBlock Text="说明你的注意力都还在。" FontSize="10" Margin="0,4,0,0"
                               Foreground="{StaticResource Tx5}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- ········ 完成列表 ········ -->
        <Grid IsVisible="{Binding IsDoneView}" RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="1,0,1,8">
            <Button Grid.Column="0" Classes="GhostBtn" Content="← 返回"
                    Command="{Binding BackCmd}"/>
            <TextBlock Grid.Column="1" Classes="SecTitle" Text="DONE"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>

          <!-- 两个标签页。这里不用「使命/初心」那套抒情命名，就叫 Todo / WD -->
          <Border Grid.Row="1" Background="{StaticResource ChipBg}" CornerRadius="9"
                  Padding="3" Margin="0,0,0,10">
            <UniformGrid Columns="2">
              <Button Classes="TabBtn" Classes.on="{Binding IsDoneTodo}"
                      Content="Todo"
                      Command="{Binding DoneTabCmd}" CommandParameter="todo"/>
              <Button Classes="TabBtn" Classes.on="{Binding IsDoneWant}"
                      Content="WD"
                      Command="{Binding DoneTabCmd}" CommandParameter="want"/>
            </UniformGrid>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <StackPanel IsVisible="{Binding IsDoneTodo}">
                <ItemsControl ItemsSource="{Binding TodoDoneGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource Tx3}" Margin="1,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="TodoCard" PointerReleased="OnDoneCardClick">
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontSize="12"
                                             Foreground="{StaticResource Cx1}"
                                             TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding MetaText}" FontSize="9.5"
                                             Foreground="{StaticResource TxFaint}"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsDoneWant}">
                <ItemsControl ItemsSource="{Binding WantDoneGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource Tx3}" Margin="1,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="TodoCard" PointerReleased="OnDoneCardClick">
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontSize="12"
                                             Foreground="{StaticResource Cx1}"
                                             TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding MetaText}" FontSize="9.5"
                                             Foreground="{StaticResource TxFaint}"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border Classes="EmptyBox" IsVisible="{Binding !HasDoneGroups}">
                <TextBlock Text="还没有完成记录。完成不是丢弃 —— 这里会记下你用了多久、写了什么。"/>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- ········ 设置视图 ········ -->
        <!--
          整页用**不透明**的 SurfaceBg —— 面板一透明，灰色小字就糊在桌面上（上游的反馈）。
          只有两处故意留着透明，好让用户能判断当前有多透：
            · 顶栏（在设置页外面，本来就跟着面板底色）
            · 「面板透明度」那一行（拖滑块时能直接看到效果）
        -->
        <ScrollViewer IsVisible="{Binding IsSetView}" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,4,0" Spacing="0">

            <Grid Margin="1,0,1,10">
              <Button HorizontalAlignment="Left" Classes="GhostBtn" Content="← 返回"
                      Command="{Binding BackCmd}"/>
              <TextBlock Text="SETTINGS" Classes="SecTitle"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Border Classes="SettingsBlock" Padding="12,12,12,2">
              <StackPanel>

                <!-- ==== 背景颜色 ==== -->
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="背景颜色" Classes="SetTitle"/>
                  <TextBlock Text="不喜欢白色的话可以换。条目卡片不受影响，永远是白底黑字。"
                             Classes="SetHint" Margin="0,4,0,9"/>
                  <!-- 直接给色块，比三个写着「白/灰/黑」的按钮直观得多 -->
                  <ItemsControl ItemsSource="{Binding ThemeOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,14,0" Cursor="Hand"
                                    PointerReleased="OnThemeSwatchClick"
                                    ToolTip.Tip="{Binding Name}">
                          <Grid Width="40" Height="40">
                            <!-- 选中圈：外面一圈紫色；没选中时不可见 -->
                            <Ellipse Width="40" Height="40" StrokeThickness="2"
                                     Stroke="{StaticResource Accent}"
                                     IsVisible="{Binding On}"/>
                            <!-- 描边必须跟着主题走：不然黑色主题下「黑」色块和底色一样、整个看不见 -->
                            <Ellipse Width="30" Height="30" Fill="{Binding Swatch}"
                                     Stroke="{StaticResource SwatchRing}" StrokeThickness="1.5"/>
                          </Grid>
                          <!-- 选中态的文字加粗变色：用 Classes 绑定而不是 Style 触发器 -->
                          <TextBlock Text="{Binding Name}" Classes="SwatchName"
                                     Margin="0,5,0,0" HorizontalAlignment="Center"
                                     Classes.on="{Binding On}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- ==== 快速模式 ==== -->
                <Grid Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="快速模式" Classes="SetTitle"/>
                    <TextBlock Text="框完就定，跳过右下角那个 ✓。一框，一分类。"
                               Classes="SetHint" Margin="0,4,0,0" MaxWidth="230"
                               HorizontalAlignment="Left"/>
                  </StackPanel>
                  <ToggleButton Classes="Switch" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsChecked="{Binding QuickCapture, Mode=TwoWay}"/>
                </Grid>

                <!-- ==== 开机自启 ==== -->
                <Grid Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="开机自启" Classes="SetTitle"/>
                    <TextBlock x:Name="AutoStartHint"
                               Text="开机就把它挂到桌面上，不用每次自己点。"
                               Classes="SetHint" Margin="0,4,0,0" MaxWidth="230"
                               HorizontalAlignment="Left"/>
                  </StackPanel>
                  <ToggleButton Classes="Switch" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsChecked="{Binding AutoStartOn, Mode=TwoWay}"/>
                </Grid>

                <!-- ==== 隐藏折叠按钮 ==== -->
                <Grid Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="隐藏折叠按钮" Classes="SetTitle"/>
                    <TextBlock Text="把顶栏的 ▾ 收起来。已经折叠着的时候它还会留着，不然你就展不开了。"
                               Classes="SetHint" Margin="0,4,0,0" MaxWidth="230"
                               HorizontalAlignment="Left"/>
                  </StackPanel>
                  <ToggleButton Classes="Switch" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsChecked="{Binding HideCollapseButton, Mode=TwoWay}"/>
                </Grid>

                <!-- ==== 演示加速 ==== -->
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="演示加速" Classes="SetTitle"/>
                  <TextBlock Text="想知道「不管它」最后会怎样，可以看一次。走完约一分钟，之后这些念想可以随便捡回来。"
                             Classes="SetHint" Margin="0,4,0,6"/>
                  <Button HorizontalAlignment="Left" Classes="GhostBtn" Padding="12,6"
                          Foreground="{StaticResource AccentDeep}"
                          Command="{Binding StartDemoCmd}"
                          Content="试试让时间以 30000 倍流逝~"/>
                </StackPanel>

              </StackPanel>
            </Border>

            <!-- 面板透明度：这一行**故意不加不透明底** ——
                 用户拖这个滑块时要能直接看到面板现在有多透 -->
            <!-- 这一行故意不加不透明底：拖滑块时能直接看到面板现在有多透。
                 上下各 7px 的间距就是两张圆角卡片之间那道缝。 -->
            <StackPanel Margin="12,7">
              <Grid Margin="0,0,0,5">
                <TextBlock Text="面板透明度" Classes="SetTitle"/>
                <TextBlock Text="{Binding OpacityText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Tx4}" HorizontalAlignment="Right"/>
              </Grid>
              <Slider Minimum="30" Maximum="100"
                      Value="{Binding OpacityPercent, Mode=TwoWay}"
                      PointerReleased="OnOpacityCommitted"/>
            </StackPanel>

            <Border Classes="SettingsBlock" Padding="12,2,12,12">
              <StackPanel>
                <StackPanel Margin="0,0,0,10">
                  <Grid Margin="0,0,0,5">
                    <TextBlock Text="Wantdo 保护期" Classes="SetTitle"/>
                    <TextBlock Text="{Binding FadeText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Tx4}" HorizontalAlignment="Right"/>
                  </Grid>
                  <Slider Minimum="1" Maximum="60"
                          Value="{Binding FadeStartDays, Mode=TwoWay}"
                          PointerReleased="OnDecayCommitted"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                  <Grid Margin="0,0,0,5">
                    <TextBlock Text="多久后放手" Classes="SetTitle"/>
                    <TextBlock Text="{Binding BinText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Tx4}" HorizontalAlignment="Right"/>
                  </Grid>
                  <Slider Minimum="2" Maximum="180"
                          Value="{Binding BinAfterDays, Mode=TwoWay}"
                          PointerReleased="OnDecayCommitted"/>
                </StackPanel>

                <TextBlock Classes="SetHint" LineHeight="16.5" Margin="0,0,0,10">
                  <Run Text="保护期内 Wantdo 完全不衰减；超过「放手」天数就滑进 Paper Plane Bin（随时能捞回来）。"/>
                  <LineBreak/>
                  <Run Text="Todo 永远不受这两个数字影响。"/>
                </TextBlock>

                <StackPanel IsVisible="{Binding ShowSeedRow}">
                  <TextBlock Text="第一次用？" Classes="SetTitle" Margin="0,0,0,6"/>
                  <Button Classes="GhostBtn" Content="灌入演示数据" Padding="12,6"
                          HorizontalAlignment="Left" Command="{Binding SeedCmd}"/>
                  <TextBlock Classes="SetHint" LineHeight="16.5" Margin="0,6,0,0"
                             Text="只在还没有任何条目时出现。想先看看它长什么样、衰减怎么跑，点这个最快。"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ============================================ 底栏 -->
      <Border Grid.Row="3" Padding="12,7"
              BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Stats}" FontSize="10"
                     Foreground="{StaticResource Tx3}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Classes="IconBtn" Content="Bin" FontSize="10" ToolTip.Tip="Paper Plane Bin"
                    Command="{Binding ShowBinCmd}"/>
            <Button Classes="IconBtn" Content="Done" FontSize="10" ToolTip.Tip="完成列表"
                    Command="{Binding ShowDoneCmd}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    </Border>

    <!--
      贴边隐藏时露在外面的那条窄边 + 一个看得见的抓手。
      它是当前这个窗口的客户区内容，所以会跟着窗口一起被挪到屏幕外 ——
      只留最右边（或最下边）那 5px 在屏幕内，用户就靠这条紫边把窗口拉回来。
    -->
    <Border x:Name="DockGrip" Width="5" Height="46" CornerRadius="3"
            Background="{StaticResource Accent}"
            IsVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
            BoxShadow="0 0 10 0 #b38b5cf6"/>

    <!-- 贴边隐藏期间的说明条 -->
    <Border x:Name="DockHintBar" IsVisible="False"
            Background="#CC1A1720" CornerRadius="8" Padding="10,6"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
      <TextBlock Text="{Binding DockHint}" FontSize="10" Foreground="#FFF2EFF7"
                 TextWrapping="Wrap" MaxWidth="280"/>
    </Border>
  </Grid>
</Window>
