<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemeberEr.PanelWindow"
        Width="340" Height="500"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        Title="记忆面板">

  <!--
    P1 骨架窗口：先把「窗口能不能正确地透明、无边框、置顶、按物理像素定位」
    这几件 mac 上最容易出错的事验证掉，再往里面填真实 UI。

    这里显示的诊断信息是移植期的验收工具，后面会收进设置页，不删。
    面板本体用半透明底色 —— 一眼就能看出透明是否真的生效
    （若不透明，桌面不会从面板后面透出来）。
  -->
  <Border x:Name="RootBorder"
          Background="#CC1A1720"
          BorderBrush="#3A333F55"
          BorderThickness="1"
          CornerRadius="14">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

      <!-- 顶栏 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="记忆面板"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#FFF2EFF7"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1"
                Background="#227C5CFF"
                CornerRadius="6"
                Padding="7,3">
          <TextBlock Text="P1 骨架"
                     FontSize="11"
                     Foreground="#FFB9A8FF" />
        </Border>
      </Grid>

      <!-- 分隔线 -->
      <Border Grid.Row="1" Height="1" Background="#2AFFFFFF" Margin="0,10,0,12" />

      <!-- 诊断信息 -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="环境诊断" FontSize="12" FontWeight="SemiBold"
                     Foreground="#FFB9A8FF" Margin="0,0,0,6" />
          <TextBlock x:Name="DiagText"
                     FontFamily="Menlo,Consolas,monospace"
                     FontSize="11"
                     Foreground="#FFD8D4E0"
                     TextWrapping="Wrap"
                     LineHeight="17" />
        </StackPanel>
      </ScrollViewer>

      <!-- 底栏：透明验证用色块 -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
        <Border Width="52" Height="22" CornerRadius="4" Background="#FF7C5CFF" />
        <Border Width="52" Height="22" CornerRadius="4" Background="#FF4ADE80" />
        <Border Width="52" Height="22" CornerRadius="4" Background="#FFFACC15" />
        <Border Width="52" Height="22" CornerRadius="4" Background="#80FFFFFF" />
        <TextBlock Text="← 透明/颜色验证"
                   FontSize="10" Foreground="#FF8A8496"
                   VerticalAlignment="Center" />
      </StackPanel>

    </Grid>
  </Border>
</Window>
