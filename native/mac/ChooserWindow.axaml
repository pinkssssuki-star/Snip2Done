<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemeberEr.ChooserWindow"
        Width="312" Height="212"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        Title="放到哪">

  <!--
    样式必须放在 Window.Styles 里，不能放 Window.Resources
    （Avalonia 报 AVLN3000，与 Theme.axaml 那次是同一个规矩）。
  -->
  <Window.Styles>
    <!--
      三个去向按钮：渐变底 + 主标题 + 副标题（和 Electron 版 chooser/index.html 一致）。
      WPF 版用 ControlTemplate + Trigger 做按下缩放；Avalonia 里同样可以，
      但这里改用样式类写法，顺手把三种配色的渐变收成三个类。
    -->
    <Style Selector="Button.ChoiceBtn">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#ffffff"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="4,7,4,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ChoiceBtn:pointerover">
      <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.ChoiceBtn:pressed">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="Button.ChoiceBtn.today">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="60%,100%">
          <GradientStop Color="#f59e0b" Offset="0"/>
          <GradientStop Color="#d97706" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.ChoiceBtn.soon">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="60%,100%">
          <GradientStop Color="#3b82f6" Offset="0"/>
          <GradientStop Color="#2563eb" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.ChoiceBtn.want">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="60%,100%">
          <GradientStop Color="#a855f7" Offset="0"/>
          <GradientStop Color="#7c3aed" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <Style Selector="Button.ChoiceBtn TextBlock">
      <Setter Property="Foreground" Value="#ffffff"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border CornerRadius="14" Background="#ffffff"
          BorderBrush="#14000000" BorderThickness="1" Padding="12"
          PointerPressed="OnRightDown">
    <Grid RowDefinitions="*,Auto,Auto,Auto">

      <!-- 缩略图 + 「这一张是 Todo 还是 Wantdo？」 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <Border x:Name="ThumbBox" Grid.Column="0" Width="64" Height="46" Margin="0,0,10,0"
                CornerRadius="7" ClipToBounds="True" VerticalAlignment="Top"
                Background="#f0f0f2">
          <Image x:Name="Thumb" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="这一张，是 Todo 还是 Wantdo？"
                     FontSize="11.5" FontWeight="SemiBold"
                     Foreground="{StaticResource Tx2}" Margin="0,0,0,3"/>
          <TextBlock x:Name="SrcText" FontSize="11" LineHeight="14.8"
                     Foreground="#8a8a8e" TextWrapping="Wrap"
                     MaxHeight="30" ClipToBounds="True"/>
        </StackPanel>
      </Grid>

      <TextBox x:Name="TitleBox" Grid.Row="1"
               Padding="9,7" Margin="0,8" FontSize="12.5"
               PlaceholderText="标题（留空则用窗口标题）"/>

      <Grid x:Name="PickRow" Grid.Row="2" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="7"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="7"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Classes="ChoiceBtn today" Click="OnPickToday">
          <StackPanel>
            <TextBlock Text="Today" FontSize="12.5" FontWeight="Bold"/>
            <TextBlock Text="一天内" FontSize="9" Opacity="0.82"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="ChoiceBtn soon" Click="OnPickSoon">
          <StackPanel>
            <TextBlock Text="Soon" FontSize="12.5" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="两三天" FontSize="9" Opacity="0.82"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="PickWant" Grid.Column="4" Classes="ChoiceBtn want" Click="OnPickWant">
          <StackPanel>
            <TextBlock Text="Wantdo" FontSize="12.5" FontWeight="Bold"/>
            <TextBlock Text="无期限" FontSize="9" Opacity="0.82"/>
          </StackPanel>
        </Button>
      </Grid>

      <!--
        底部提示行。天数输入框放在这里而不是塞进 Soon 按钮里 ——
        塞进去的话中间的选项就变成三层（大字 + 小字 + 输入框），
        而两侧只有两层，一眼就看得出排版不一样（上游收到的反馈）。
        右边原来是「留空则用窗口标题」，那条提示本来就多余（输入框里都写着呢），
        换成「想指定天数就写 [__] 天」。
      -->
      <Grid Grid.Row="3">
        <TextBlock Text="Esc 算了 · 1 2 3 直接选"
                   FontSize="9.5" Foreground="#b0b0b6" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="想指定天数就写" FontSize="9.5" Foreground="#b0b0b6"
                     VerticalAlignment="Center"/>
          <TextBox x:Name="DaysBox" Width="30" Height="16" Padding="0"
                   FontSize="9.5" FontWeight="SemiBold"
                   Margin="3,0,0,0" CornerRadius="4"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   KeyDown="OnDaysKeyDown" TextInput="OnDaysInput"/>
          <TextBlock Text="天" FontSize="9.5" Foreground="#b0b0b6"
                     Margin="3,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
