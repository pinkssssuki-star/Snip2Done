<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    控件样式。设计 token（颜色、转换器、字体）在 Theme.axaml 里，
    这里只放「长什么样」。

    Avalonia 要求样式放在 <Styles> 根下，不能塞进 ResourceDictionary
    （塞了会报 AVLN3000），所以拆成两个文件。
  -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
  </Style>

  <Style Selector="Button.IconBtn">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button.IconBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#12000000"/>
  </Style>

  <Style Selector="Button.IconBtn[Tag=on]">
    <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
  </Style>

  <Style Selector="Button.IconBtn[Tag=danger]:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1adc2626"/>
  </Style>

  <Style Selector="Button.IconBtn[Tag=danger]:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Red}"/>
  </Style>

  <Style Selector="TextBlock.SecTitle">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
  </Style>

  <Style Selector="Border.CountBadge">
    <Setter Property="Background" Value="#12000000"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6,1"/>
  </Style>

  <Style Selector="Border.CountBadge > TextBlock">
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
  </Style>

  <Style Selector="Border.EmptyBox">
    <Setter Property="Background" Value="#08000000"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="12,14"/>
  </Style>

  <Style Selector="Border.EmptyBox > TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource TxFaint}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Border.TodoCard">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{StaticResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,8"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Border.TodoCard:pointerover">
    <Setter Property="BorderBrush" Value="#33000000"/>
  </Style>

  <Style Selector="Border.TodoCard.done">
    <Setter Property="Background" Value="#f4f4f6"/>
  </Style>

  <Style Selector="Button.Check">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Background" Value="#ffffff"/>
    <Setter Property="BorderBrush" Value="#38000000"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style Selector="Button.Check:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
  </Style>

  <Style Selector="Button.Check.checked">
    <Setter Property="Background" Value="{StaticResource Green}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
  </Style>

  <Style Selector="Button.Check > TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button.Check.checked > TextBlock">
    <Setter Property="Foreground" Value="#ffffff"/>
  </Style>

  <Style Selector="Border.Pill">
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="Background" Value="{StaticResource PillPlainBg}"/>
  </Style>

  <Style Selector="Border.Pill > TextBlock">
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
  </Style>

  <Style Selector="Border.Pill.today">
    <Setter Property="Background" Value="{StaticResource PillTodayBg}"/>
  </Style>

  <Style Selector="Border.Pill.today > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PillTodayFg}"/>
  </Style>

  <Style Selector="Border.Pill.soon">
    <Setter Property="Background" Value="{StaticResource PillSoonBg}"/>
  </Style>

  <Style Selector="Border.Pill.soon > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PillSoonFg}"/>
  </Style>

  <Style Selector="Border.Pill.bad">
    <Setter Property="Background" Value="{StaticResource PillBadBg}"/>
  </Style>

  <Style Selector="Border.Pill.bad > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PillBadFg}"/>
  </Style>

  <Style Selector="Border.CardThumb">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="#f0f0f2"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.Tile">
    <Setter Property="Width" Value="150"/>
    <Setter Property="Height" Value="122"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{StaticResource TileBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style Selector="Border.Tile:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>

  <!--
    生命条是「2px 细线」，但 ProgressBar 的默认模板带内边距和最小高度，
    直接设 Height=3 会被模板的最小尺寸顶回默认高度，于是看起来像一条粗灰条、
    还把磁贴里其它内容挤掉。
    所以要连 MinHeight 和模板内部元素一起约束掉（真实踩到的坑）。
  -->
  <Style Selector="ProgressBar.LifeBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="#14000000"/>
    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
  </Style>
  <Style Selector="ProgressBar.LifeBar /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="2"/>
  </Style>

  <Style Selector="ProgressBar.LifeBar.low">
    <Setter Property="Foreground" Value="#f59e0b"/>
  </Style>

  <Style Selector="ProgressBar.LifeBar.critical">
    <Setter Property="Foreground" Value="{StaticResource Red}"/>
  </Style>

  <!-- ============================================================ 标签页（纸篓/完成 分房间） -->
  <Style Selector="Button.TabBtn">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{StaticResource Tx4}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="0,5"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.TabBtn:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
  </Style>
  <!-- 放在悬停之后：选中态要压过悬停 -->
  <Style Selector="Button.TabBtn.on">
    <Setter Property="Background" Value="{StaticResource TabOnBg}"/>
    <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- ============================================================ 幽灵按钮（返回 / 倒垃圾） -->
  <Style Selector="Button.GhostBtn">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Tx4}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Background" Value="{StaticResource BtnBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.GhostBtn:pointerover">
    <Setter Property="Background" Value="{StaticResource BtnBgHover}"/>
    <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
  </Style>
  <!-- 危险操作（倒垃圾的二次确认）：红底白字。
       它是整个程序里唯一不可逆的操作，所以视觉上要明确区别于别的按钮。 -->
  <Style Selector="Button.GhostBtn.danger">
    <Setter Property="Background" Value="{StaticResource Red}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
    <Setter Property="Foreground" Value="#ffffff"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.GhostBtn.danger:pointerover">
    <Setter Property="Background" Value="{StaticResource Red}"/>
    <Setter Property="Foreground" Value="#ffffff"/>
    <Setter Property="Opacity" Value="0.9"/>
  </Style>

  <!-- ============================================================ 纸篓小卡片 -->
  <Style Selector="Border.BinCard">
    <Setter Property="Height" Value="100"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{StaticResource CardBg}"/>
    <Setter Property="BorderBrush" Value="#29000000"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="3,0,3,6"/>
    <Setter Property="Opacity" Value="0.72"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.BinCard:pointerover">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>
  <!-- 使命 Todo：不能捡回，鼠标也不该显示成可点 -->
  <Style Selector="Border.BinCard.norestore">
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>

  <!-- ============================================================ 设置页的开关 -->
  <!--
    自己写一份 ToggleButton 模板，而不是去改 CheckBox 模板的内部元素。
    原因：模板里的元素名属于主题的实现细节，SimpleTheme 和 FluentTheme 不一样
    （我第一版按 NormalRectangle 去改，结果样式没生效、开关渲染成一个空方框）。
    自己写一份就与主题无关，也不会因为换主题而散架。
  -->
  <Style Selector="ToggleButton.Switch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="42"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{StaticResource TrackBg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="track" CornerRadius="12" Background="{TemplateBinding Background}"
                Width="42" Height="24">
          <Ellipse x:Name="knob" Width="18" Height="18" Fill="{StaticResource ThumbBg}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- 打开：底色换成强调色、圆点滑到右边 -->
  <Style Selector="ToggleButton.Switch:checked /template/ Border#track">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
  </Style>
  <Style Selector="ToggleButton.Switch:checked /template/ Ellipse#knob">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,3,0"/>
  </Style>
  <Style Selector="ToggleButton.Switch:pointerover /template/ Border#track">
    <Setter Property="Opacity" Value="0.9"/>
  </Style>

  <!-- ============================================================ 设置页的分区容器 -->
  <!-- 整块不透明：面板一透明，灰色小字就糊在桌面上了 -->
  <Style Selector="Border.SettingsBlock">
    <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="TextBlock.SetTitle">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
  </Style>
  <Style Selector="TextBlock.SetHint">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{StaticResource HintTx}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- 主题色块下的名字：选中时加粗变紫。
       注意选择器写成 TextBlock.SwatchName 而不是光 TextBlock ——
       通用 TextBlock 规则会误伤别处（字体大小、颜色全被改掉）。 -->
  <Style Selector="TextBlock.SwatchName">
    <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style Selector="TextBlock.SwatchName.on">
    <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 演示横幅：橙色 = 正在发生，紫色 = 说完了 -->
  <Style Selector="Border.DemoBanner">
    <Setter Property="Background" Value="#16f59e0b"/>
    <Setter Property="BorderBrush" Value="#33f59e0b"/>
  </Style>
  <Style Selector="Border.DemoBanner.finished">
    <Setter Property="Background" Value="#168b5cf6"/>
    <Setter Property="BorderBrush" Value="#338b5cf6"/>
  </Style>

  <!-- ============================================================ 房间选择按钮（Todo / Wantdo） -->
  <Style Selector="Button.RoomBtn">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="0,6"/>
    <Setter Property="Background" Value="{StaticResource BtnBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <!-- 选中态：紫色底 + 紫边 + 紫字（上游用 Tag=on，这里用 Classes.on） -->
  <Style Selector="Button.RoomBtn.on">
    <Setter Property="Background" Value="#268b5cf6"/>
    <Setter Property="BorderBrush" Value="#8c8b5cf6"/>
    <Setter Property="Foreground" Value="#6d28d9"/>
  </Style>

  <!-- ============================================================ 快速输入框 -->
  <Style Selector="TextBox.QuickInput">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Tx1}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Background" Value="{StaticResource InputBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="TextBox.QuickInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#a68b5cf6"/>
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
</Styles>
