# ---- 依赖与缓存 ----
node_modules/
.npm-cache/
.electron-cache/
.eb-cache/
.localappdata/
.userdata/
.userdata-pkg/
.userdata-guide/

# ---- 运行期产物（截图、日志、测量数据）----
.guide/
.tmp/
dist/
*.log
ui-*.ok

# ---- 主版本：编译产物，以及从 NuGet 取来的参考程序集 ----
native/out/
native/obj/
native/refasm/

# ---- macOS 版（Avalonia）：编译产物 ----
native/mac/bin/
native/mac/obj/

# ---- macOS 版：dev-env.sh 的缓存目录 ----
# tools/dev-env.sh 把 NuGet 缓存 / dotnet HOME 指到仓库内的 .dev/ 下
# （放在仓库内是为了「克隆到哪都成立」，之前取的仓库上一级可能不可写）。
# 这个目录有 1.3 GB，绝不能进版本库。

# ---- dotnet 的 HOME / 缓存落到仓库时的兜底 ----
# 若有人直接跑 dotnet（没 source dev-env.sh），它们会落在仓库根目录。
.nuget/
.dotnet/
.local/

# ---- legacy：WebView2 SDK 是第三方解压产物 ----
legacy/wpf-webview2/webview2/
legacy/wpf-webview2/out/
.dev/
