# ---- 依赖与缓存 ----
node_modules/
.npm-cache/
.electron-cache/
.eb-cache/
.localappdata/
.userdata/
.userdata-pkg/
.userdata-guide/

# ---- 运行期产物（截图、日志、测量数据）----
.guide/
.tmp/
dist/
*.log
ui-*.ok

# ---- 主版本：编译产物，以及从 NuGet 取来的参考程序集 ----
native/out/
native/obj/
native/refasm/

# ---- macOS 版（Avalonia）：编译产物 ----
native/mac/bin/
native/mac/obj/

# ---- dotnet 的 HOME / 缓存落到仓库时的兜底 ----
# 正常情况下 tools/dev-env.sh 会把它们指到仓库外层的 .dev/，
# 但若有人直接跑 dotnet（没 source dev-env.sh），它们会落在仓库根目录。
.nuget/
.dotnet/
.local/

# ---- legacy：WebView2 SDK 是第三方解压产物 ----
legacy/wpf-webview2/webview2/
legacy/wpf-webview2/out/
