<?xml version="1.0" encoding="utf-8"?>
<!--
  本项目开发环境在受限网络下，NuGet 拉包需要走本地代理。
  dotnet restore 会读取工作目录或其上层任意一级的 NuGet.config，
  所以在仓库根目录放一份即可对所有子项目生效。
  代理地址与 ~/.zshrc 里的 HTTP_PROXY 保持一致（Clash 默认 7897）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="http_proxy" value="http://127.0.0.1:7897" />
    <add key="https_proxy" value="http://127.0.0.1:7897" />
  </config>
</configuration>
